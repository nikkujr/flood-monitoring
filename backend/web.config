<?xml version="1.0" encoding="utf-8"?>
<!-- Deployment refresh: 2026-09-21 residents and evacuation support v2 -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="BantayBahaNode" path="*" verb="*" modules="httpPlatformHandler" />
    </handlers>
    <httpPlatform processPath="node" arguments="dist/server.js" startupTimeLimit="60" startupRetryCount="3" stdoutLogEnabled="true" stdoutLogFile="logs/node-stdout.log">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <authentication>
        <anonymousAuthentication enabled="true" />
        <basicAuthentication enabled="false" />
        <windowsAuthentication enabled="false" />
      </authentication>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
