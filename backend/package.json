{
  "name": "bantay-baha-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:init": "tsx src/database.ts init && tsx src/seed.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:report-reviews": "tsx src/migrate-report-reviews.ts",
    "db:migrate:rescue": "tsx src/migrate-rescue.ts",
    "db:migrate:responders-outcomes": "tsx src/migrate-responders-outcomes.ts",
    "db:fresh": "tsx src/database.ts fresh && tsx src/seed.ts",
    "seed": "tsx src/seed.ts",
    "seed:users": "tsx src/seed-users.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.0.10",
    "qs": "^6.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  },
  "packageManager": "npm@11.9.0",
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
