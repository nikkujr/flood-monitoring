NODE_ENV=production
# PORT is injected automatically by SMARTERASP.NET/IIS. Do not set it here.
DATABASE_URL=mysql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:3306/DATABASE_NAME
FRONTEND_ORIGINS=https://bantaybaha2026-001-site1.ktempurl.com
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_MAX_AGE_MS=604800000
UPLOAD_ROOT=storage/uploads
FRONTEND_DIST_ROOT=public
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
# Password-reset email is disabled until all SMTP values below are filled in.
# For port 465 set SMTP_SECURE=true; for port 587 keep it false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BantayBaha <no-reply@bantaybaha.local>
PASSWORD_RESET_URL=https://bantaybaha2026-001-site1.ktempurl.com/reset-password
